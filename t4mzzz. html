<script>
const whatsappAdmin = "6283878548872";

function contactAdmin() {
  const text = encodeURIComponent("Halo Admin T4MZZ, saya membutuhkan bantuan.");
  window.open("https://wa.me/" + whatsappAdmin + "?text=" + text, "_blank");
}

function selectTopup(element, nominal) {
  document.querySelectorAll(".topup").forEach(item => {
    item.classList.remove("active");
  });

  element.classList.add("active");
  showMessage("Nominal dipilih: " + nominal);
}

function showMessage(message) {
  alert(message);
}
</script>

